# Backend env vars (Express) — copy to .env and fill in real values.
# See docs/environments.md for how to get dev vs. prod values for each.

# Clerk secret key. Use your Clerk DEVELOPMENT instance's secret key for
# local work — never point local dev at the production Clerk instance.
CLERK_SECRET_KEY=

# Port the Express server listens on locally.
PORT=3001

# Origin the frontend is served from — used for the CORS allowlist.
FRONTEND_ORIGIN=http://localhost:5173

# Standard Node environment flag.
NODE_ENV=development

# Shared secret checked on the /api/notifications/send-expiry cron endpoint
# (Vercel Cron sends it as a Bearer token). Any random string works locally.
CRON_SECRET=

# Web Push (VAPID) keys — same key pair across environments is fine, or
# generate a separate pair for dev with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Resend (transactional email for invites).
RESEND_API_KEY=
EMAIL_FROM=

# Postgres connection strings from a Neon DB branch — use the "dev" branch
# for local work, never the production branch. DATABASE_URL is the pooled
# connection (used at runtime), DATABASE_URL_UNPOOLED is the direct
# connection (used by Prisma Migrate).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Spoonacular API key (server-only — never exposed to the frontend). Powers
# /api/recipes/search and /api/recipes/:id. If unset, those routes still boot
# but respond 500 { error: 'configError' } when actually invoked.
SPOONACULAR_KEY=

# Groq API key. Used only to translate recipe content (title/ingredients/
# instructions) to the UI language, since Spoonacular doesn't support Spanish.
# If unset, recipe content is served in English (fail-soft, no error).
GROQ_API_KEY=
