datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id  // Clerk user ID (e.g., "user_2abc...")
  username  String   @unique
  email     String   @unique
  createdAt DateTime @default(now())

  linksAsUser       UserLink[]         @relation("UserLinks")
  linksAsPartner    UserLink[]         @relation("PartnerLinks")
  products          Product[]
  shoppingItems     ShoppingItem[]
  pushSubscriptions PushSubscription[]
}

model Product {
  id           Int       @id @default(autoincrement())
  name         String
  quantity     String    @default("")
  brand        String    @default("")
  purchaseDate String    @default("")
  expiryDate   DateTime?
  location     String    @default("")
  details      String    @default("")
  ownerId      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, expiryDate])
}

model ShoppingItem {
  id           Int      @id @default(autoincrement())
  name         String
  quantity     String   @default("")
  brand        String   @default("")
  purchaseDate String   @default("")
  expiryDate   String   @default("")
  location     String   @default("")
  details      String   @default("")
  purchased    Boolean  @default(false)
  ownerId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserLink {
  id        Int      @id @default(autoincrement())
  userId    String
  partnerId String
  createdAt DateTime @default(now())

  user    User @relation("UserLinks",   fields: [userId],    references: [id], onDelete: Cascade)
  partner User @relation("PartnerLinks", fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([userId, partnerId])
}
