datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id // Clerk user ID (e.g., "user_2abc...")
  username   String   @unique
  email      String   @unique
  // "metric" | "imperial" — null means "never explicitly chosen"; the client
  // and the chat prompt both resolve a null value from the UI language
  // instead (es -> metric, otherwise imperial). Deliberately nullable rather
  // than defaulted, so an untouched preference stays distinguishable from an
  // explicit choice that happens to match the locale default.
  unitSystem String?
  createdAt  DateTime @default(now())

  linksAsUser           UserLink[]             @relation("UserLinks")
  linksAsPartner        UserLink[]             @relation("PartnerLinks")
  products              Product[]
  shoppingItems         ShoppingItem[]
  pushSubscriptions     PushSubscription[]
  sentInvitations       LinkInvitation[]       @relation("SentInvitations")
  receivedInvitations   LinkInvitation[]       @relation("ReceivedInvitations")
  shoppingLists         ShoppingList[]
  favoriteRecipes       FavoriteRecipe[]
  favoriteIngredients   FavoriteIngredient[]
  favoriteStores        FavoriteStore[]
  favoriteShoppingLists FavoriteShoppingList[]
  favoriteMealPlans     FavoriteMealPlan[]
  chatConversations     ChatConversation[]
  mealPlans             MealPlan[]
}

// Personal AI cooking-assistant conversations (Groq-backed "Chat" tab).
// Not shared with a linked partner via accessibleUserIds — same reasoning as
// FavoriteRecipe: a personal conversation isn't shared household data.
// dietaryRestrictions/servings are captured once via UI chips/stepper when
// the conversation is created and fed into every system-prompt build, rather
// than asked conversationally by the model.
model ChatConversation {
  id                  String   @id @default(cuid())
  ownerId             String
  title               String
  dietaryRestrictions String[] @default([])
  servings            Int      @default(2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  owner    User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([ownerId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // 'user' | 'assistant'
  content        String
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// A bookmark onto a recipe id — deliberately not a cached snapshot of the
// recipe's content (title/image/etc.). The provider (Spoonacular or Edamam)
// stays the single source of truth; the favorites list is re-hydrated via
// getRecipeInformation/getEdamamRecipeInformation (same as the detail
// endpoint) each time it's read, so translations/edits on the provider's
// side are always reflected. `recipeId` is the compound "source:externalId"
// form produced by makeRecipeId (recipeSerializers.ts), not a bare provider
// id — this is what lets a Spoonacular numeric id and an Edamam uri coexist
// without colliding. Personal per-user (not shared with a linked partner via
// accessibleUserIds), unlike pantry/shopping — favoriting a recipe is closer
// to a personal bookmark than shared household data.
model FavoriteRecipe {
  id        String   @id @default(cuid())
  ownerId   String
  recipeId  String
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, recipeId])
  @@index([ownerId])
}

// A bare bookmark of a free-text ingredient name — there's no reusable
// "ingredient" entity elsewhere in the schema (Product is a full pantry
// item, RecipeIngredient/MealIngredient are transient recipe-scoped
// shapes), so this is just a saved string, surfaced as a 4th chip source in
// IngredientPicker (pantry / common / favorites / free text). Personal, not
// shared via accessibleUserIds — same reasoning as FavoriteRecipe.
model FavoriteIngredient {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, name])
  @@index([ownerId])
}

// A snapshot, not a bookmark — unlike FavoriteRecipe, there's no backend
// endpoint to re-hydrate a store by placeId later (Geoapify's Places API has
// no "detail by id" call wired up here), so what the search already
// returned (name/type/coords) is saved as-is at favorite time. `placeId` is
// Geoapify's own id (RawNearbyStore.id). Personal, not shared via
// accessibleUserIds — same reasoning as FavoriteRecipe.
model FavoriteStore {
  id        String   @id @default(cuid())
  ownerId   String
  placeId   String
  name      String
  type      String
  lat       Float
  lon       Float
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, placeId])
  @@index([ownerId])
}

// A pointer, not a snapshot — unlike FavoriteStore, the ShoppingList itself
// stays live in the DB (can be renamed, gets items added/removed), so this
// just pins a listId. Distinct from the (not yet built, see ROADMAP.md)
// "archive a list" idea: archiving hides a list from the normal dropdown,
// this is an unrelated quick-access bookmark — a list could be both,
// neither, or either independently. Personal: the bookmark itself isn't
// shared via accessibleUserIds even though a shopping list can be (a linked
// partner with access to the same list favorites it separately, if at all).
model FavoriteShoppingList {
  id        String   @id @default(cuid())
  ownerId   String
  listId    String
  createdAt DateTime @default(now())

  owner User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  list  ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([ownerId, listId])
  @@index([ownerId])
}

// A weekly meal plan — one MealPlanEntry per day, each just a bookmark onto
// a compound recipe id (see FavoriteRecipe's own comment on the
// "source:externalId" form, title/image cached here purely so the calendar
// UI doesn't need N recipe-detail lookups just to render a grid of cards;
// the full recipe still comes from its provider on drill-down, same as
// FavoriteRecipe's "don't cache recipe content" philosophy). Personal, not
// shared via accessibleUserIds — same reasoning as ChatConversation.
model MealPlan {
  id                  String   @id @default(cuid())
  ownerId             String
  weekStart           DateTime
  // Kept so a later /refine request can rebuild the same generation context
  // (system prompt) the original plan was created with — these aren't
  // editable after creation, unlike the free-text refinement itself.
  dietaryRestrictions String[] @default([])
  servings            Int      @default(2)
  includeBreakfast    Boolean  @default(false)
  // { menu: string[], totalQuantities: [{name,amount,unit}], cookingOrder:
  // string[], storageNotes: string, estimatedTotalMinutes: number } — a
  // single batch-cooking session covering (some or all of) the week's
  // meals. See mealPlanAi.ts for the exact shape.
  batchPrepPlan       Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  owner User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  days  MealPlanEntry[]

  @@index([ownerId])
}

model MealPlanEntry {
  id         String @id @default(cuid())
  mealPlanId String
  dayOfWeek  Int // 0-6
  // "breakfast" | "lunch" | "dinner"
  mealType   String

  // Full recipe content, generated by the AI (mealPlanAi.ts) — unlike the
  // old Spoonacular/Edamam-bookmark design, there's no external recipeId to
  // look content up by later, so it's stored here directly.
  title            String
  description      String   @default("")
  // Resolved by name against Spoonacular/Edamam purely for a matching photo
  // (see mealPlanAi.ts) — can stay empty; the frontend falls back to a
  // meal-type icon when it is.
  image            String   @default("")
  ingredients      Json // [{ name, amount, unit }]
  steps            String[] // each step has its quantities embedded in the text
  notes            String   @default("") // substitutions, variants, storage/reheat tips
  prepTimeMinutes  Int?
  totalTimeMinutes Int?

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@unique([mealPlanId, dayOfWeek, mealType])
}

// A snapshot, not a pointer — a MealPlan is transient (explicitly deleted,
// or just buried once a new one is generated past the 10-per-user cap), and
// there's no external id to re-hydrate from (same AI-generated-content
// reasoning as MealPlanEntry itself). Favoriting copies the whole week's
// content here, independent of the live MealPlan's lifecycle.
model FavoriteMealPlan {
  id      String @id @default(cuid())
  ownerId String
  name    String
  // Metadata only, no FK — the live MealPlan can be deleted without
  // affecting this row. Just lets Mealprep show "already favorited" for the
  // plan currently on screen, so it doesn't offer to duplicate it silently.
  sourceMealPlanId    String?
  dietaryRestrictions String[] @default([])
  servings            Int      @default(2)
  includeBreakfast    Boolean  @default(false)
  batchPrepPlan       Json?
  createdAt           DateTime @default(now())

  owner User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  days  FavoriteMealPlanEntry[]

  @@index([ownerId])
}

model FavoriteMealPlanEntry {
  id                 String @id @default(cuid())
  favoriteMealPlanId String
  dayOfWeek          Int
  mealType           String

  title            String
  description      String   @default("")
  image            String   @default("")
  ingredients      Json
  steps            String[]
  notes            String   @default("")
  prepTimeMinutes  Int?
  totalTimeMinutes Int?

  favoriteMealPlan FavoriteMealPlan @relation(fields: [favoriteMealPlanId], references: [id], onDelete: Cascade)

  @@unique([favoriteMealPlanId, dayOfWeek, mealType])
}

model ShoppingList {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  isGeneral Boolean  @default(false)
  createdAt DateTime @default(now())

  owner       User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items       ShoppingItem[]
  favoritedBy FavoriteShoppingList[]

  @@index([ownerId])
}

model Product {
  id           Int       @id @default(autoincrement())
  name         String
  quantity     String    @default("")
  brand        String    @default("")
  purchaseDate String    @default("")
  expiryDate   DateTime?
  location     String    @default("")
  details      String    @default("")
  ownerId      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, expiryDate])
}

model ShoppingItem {
  id           Int      @id @default(autoincrement())
  name         String
  quantity     String   @default("")
  brand        String   @default("")
  purchaseDate String   @default("")
  expiryDate   String   @default("")
  location     String   @default("")
  details      String   @default("")
  purchased    Boolean  @default(false)
  ownerId      String
  listId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  list  ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LinkInvitation {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  status      String   @default("pending") // pending | accepted | declined | expired
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  sender    User @relation("SentInvitations", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedInvitations", fields: [recipientId], references: [id], onDelete: Cascade)
}

model UserLink {
  id        Int      @id @default(autoincrement())
  userId    String
  partnerId String
  createdAt DateTime @default(now())

  user    User @relation("UserLinks", fields: [userId], references: [id], onDelete: Cascade)
  partner User @relation("PartnerLinks", fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([userId, partnerId])
}
