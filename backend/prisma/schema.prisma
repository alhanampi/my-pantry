datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id  // Clerk user ID (e.g., "user_2abc...")
  username   String   @unique
  email      String   @unique
  // "metric" | "imperial" — null means "never explicitly chosen"; the client
  // and the chat prompt both resolve a null value from the UI language
  // instead (es -> metric, otherwise imperial). Deliberately nullable rather
  // than defaulted, so an untouched preference stays distinguishable from an
  // explicit choice that happens to match the locale default.
  unitSystem String?
  createdAt  DateTime @default(now())

  linksAsUser         UserLink[]         @relation("UserLinks")
  linksAsPartner      UserLink[]         @relation("PartnerLinks")
  products            Product[]
  shoppingItems       ShoppingItem[]
  pushSubscriptions   PushSubscription[]
  sentInvitations     LinkInvitation[]   @relation("SentInvitations")
  receivedInvitations LinkInvitation[]   @relation("ReceivedInvitations")
  shoppingLists       ShoppingList[]
  favoriteRecipes     FavoriteRecipe[]
  chatConversations   ChatConversation[]
}

// Personal AI cooking-assistant conversations (Groq-backed "Chat" tab).
// Not shared with a linked partner via accessibleUserIds — same reasoning as
// FavoriteRecipe: a personal conversation isn't shared household data.
// dietaryRestrictions/servings are captured once via UI chips/stepper when
// the conversation is created and fed into every system-prompt build, rather
// than asked conversationally by the model.
model ChatConversation {
  id                  String   @id @default(cuid())
  ownerId             String
  title               String
  dietaryRestrictions String[] @default([])
  servings            Int      @default(2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  owner    User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([ownerId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // 'user' | 'assistant'
  content        String
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// A bookmark onto a Spoonacular recipe id — deliberately not a cached
// snapshot of the recipe's content (title/image/etc.). Spoonacular stays the
// single source of truth; the favorites list is re-hydrated via
// getRecipeInformation (same as the detail endpoint) each time it's read, so
// translations/edits on Spoonacular's side are always reflected. Personal
// per-user (not shared with a linked partner via accessibleUserIds), unlike
// pantry/shopping — favoriting a recipe is closer to a personal bookmark
// than shared household data.
model FavoriteRecipe {
  id        String   @id @default(cuid())
  ownerId   String
  recipeId  Int
  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, recipeId])
  @@index([ownerId])
}

model ShoppingList {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  isGeneral Boolean  @default(false)
  createdAt DateTime @default(now())

  owner User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items ShoppingItem[]

  @@index([ownerId])
}

model Product {
  id           Int       @id @default(autoincrement())
  name         String
  quantity     String    @default("")
  brand        String    @default("")
  purchaseDate String    @default("")
  expiryDate   DateTime?
  location     String    @default("")
  details      String    @default("")
  ownerId      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, expiryDate])
}

model ShoppingItem {
  id           Int      @id @default(autoincrement())
  name         String
  quantity     String   @default("")
  brand        String   @default("")
  purchaseDate String   @default("")
  expiryDate   String   @default("")
  location     String   @default("")
  details      String   @default("")
  purchased    Boolean  @default(false)
  ownerId      String
  listId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  list  ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LinkInvitation {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  status      String   @default("pending") // pending | accepted | declined | expired
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  sender    User @relation("SentInvitations",    fields: [senderId],    references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedInvitations", fields: [recipientId], references: [id], onDelete: Cascade)
}

model UserLink {
  id        Int      @id @default(autoincrement())
  userId    String
  partnerId String
  createdAt DateTime @default(now())

  user    User @relation("UserLinks",   fields: [userId],    references: [id], onDelete: Cascade)
  partner User @relation("PartnerLinks", fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([userId, partnerId])
}
