    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "groq-sdk": "^1.6.0",
    "helmet": "^7.1.0",
    "resend": "^6.12.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
