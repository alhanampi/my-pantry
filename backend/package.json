{
  "name": "mi-despensa-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "backfill:shopping-lists": "tsx scripts/backfill-shopping-lists.ts",
