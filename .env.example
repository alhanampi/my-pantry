# Frontend env vars (Vite) — copy to .env and fill in real values.
# See docs/environments.md for how to get dev vs. prod values for each.

# Base URL of the backend API. Empty string works locally (`npm run dev`
# proxies through Vite/Express on the same origin); set explicitly for
# any deployed environment.
VITE_API_URL=

# Clerk publishable key. Use your Clerk DEVELOPMENT instance's key for
# local work — never point local dev at the production Clerk instance.
VITE_CLERK_PUBLISHABLE_KEY=

# Same VAPID public key as the backend's VAPID_PUBLIC_KEY (see backend/.env.example).
VITE_VAPID_PUBLIC_KEY=

# Geoapify API key, used for the nearby-supermarkets search.
VITE_GEOAPIFY_KEY=
