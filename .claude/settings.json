{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(npx ts-node *)",
      "Bash(npx prettier *)",
      "Skill(schedule)",
      "Skill(update-config)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-schema.ps1",
            "shell": "powershell",
            "statusMessage": "Checking Prisma schema...",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm run type-check 2>&1 | Select-String 'error TS' | Select-Object -First 10",
            "shell": "powershell",
            "statusMessage": "Type checking...",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ]
  }
}
